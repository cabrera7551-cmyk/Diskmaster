{
  "name": "diskmaster",
  "version": "1.0.0",
  "description": "DISKMASTER — Herramienta portable para gestión de almacenamiento",
  "main": "src/main.js",
  "author": "Técnico",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder --win portable",
    "build:dir": "electron-builder --win portable --dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.diskmaster.app",
    "productName": "DiskMaster",
    "icon": "assets/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "services/**/*",
      "modules/**/*",
      "utils/**/*",
      "reports/**/*",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "DiskMaster.exe"
    },
    "portable": {
      "artifactName": "DiskMaster.exe"
    }
  }
}
